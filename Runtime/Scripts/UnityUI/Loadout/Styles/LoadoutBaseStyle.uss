VisualElement { background-color: rgba(0, 0, 0, 0.6); }

/* layout */
.l-row { flex-direction: row; }
.l-column { flex-direction: column; }
.l-fill { flex-grow: 1; flex-shrink: 1; }
.l-fixed { flex-grow: 0; flex-shrink: 0; }
.l-wrap { flex-wrap: wrap; align-content: flex-start; }
.l-absolute { position: absolute; left:0; top:0; right:0; bottom:0; }
.l-collection-root { align-items: flex-start; }

/* component */
.c-main { padding: 12px; }
.c-collection { margin-bottom: 16px; }
.c-container { margin-bottom: 12px; }
.c-area { position: relative; }

.c-item-layer { position: absolute; left:0; top:0; right:0; bottom:0; /*pointer-events: none;*/ }

/* skin */
.s-role-label { font-size: 18px; /*font-weight: bold;*/ color: white; margin-bottom: 8px; }
.s-source-label { font-size: 13px; color: rgba(255,255,255,0.7); margin-bottom: 4px; }

.s-panel { background-color: rgba(31, 18, 7, 0.54); padding: 8px; border-radius: 6px; border-width: 1px; border-color: rgba(255,255,255,0.4); }

.s-container { padding: 6px; }
.s-grid { position: relative; }
.s-socket { padding: 4px; }

.s-item-selected { border-width: 2px; border-color: rgba(255, 255, 0, 0.9); border-radius: 4px; }

/* .s-item-selected { border-width: 2px; border-color: rgba(255, 215, 0, 1); box-shadow: 0 0 6px rgba(255, 215, 0, 0.8); } */

.s-item { background-color: rgba(255, 200, 50, 0.8); }
.s-cell { position: absolute; border-width: 1px; border-color: rgba(245, 245, 245, 0.64); }